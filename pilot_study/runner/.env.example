# Copy this file to .env and fill in your own values.
# .env is already gitignored - only .env.example (this file) is meant to be committed.

# Required for every attempt (used to call the Anthropic API for the runner agent)
ANTHROPIC_API_KEY=

# Required only for the task1-git task (the gh CLI needs an authenticated token
# for the frozen target repo)
GH_TOKEN=
